# Backend API base URL (include trailing slash)
VITE_BACKEND_URL=https://your-backend-url.com/

# Payment portal URL (used in invoice instructions when payments are disabled)
VITE_PAYMENT_URL=https://your-payment-url.com/

# Encryption settings for PHP-originated encrypted data
# Key must be exactly 16 characters (AES-128)
VITE_ENCRYPTION_KEY=your16charkey___
# IV must be exactly 16 characters
VITE_ENCRYPTION_DECRYPTION_IV=your16chariv____
# Cipher mode (default: AES-128-CTR)
VITE_CIPHERING=AES-128-CTR

# Logging level: ALL | DEBUG | INFO | WARN | ERROR | NONE (default: ALL)
VITE_LOG_LEVEL=WARN
